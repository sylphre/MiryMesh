#
# Public Read を許可したバケットを、公開用ドメインから「読み取り専用」で配る例。
# 配置: /etc/nginx/conf.d/mirymesh-public-read.conf  →  nginx -t && systemctl reload nginx
#
# 公開 URL の形:  https://files.example.com/<bucket>/<key>
#
# 使い方
#   1. バケットのアクセスを Public Read にする（Public URL のアイコンは Public Read のバケットにだけ出る）
#   2. バケット詳細の「許可するドメイン」に files.example.com を追加する
#      ※ 一覧を設定すると、一覧に無い Host からそのバケットへのリクエストは 403 AccessDenied になる。
#        S3 クライアントが使うホスト (s3.example.com など) も一覧に入れること。
#   3. この設定の server_name を files.example.com に合わせる
#
# このサーバーブロックは GET / HEAD だけを通す。PUT / DELETE などは NGINX が 403 で止める。
# 認証付きの操作は mirymesh-s3.conf.example 側のホストを使う。

server {
    listen 80;
    server_name files.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name files.example.com;

    ssl_certificate     /etc/letsencrypt/live/files.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/files.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    proxy_buffering    off;
    proxy_http_version 1.1;

    # バケットのドメイン判定に使うので、元の Host を渡す
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        # limit_except GET は GET と HEAD を許可し、それ以外のメソッドを拒否する
        limit_except GET {
            deny all;
        }
        proxy_pass http://127.0.0.1:9000;
        proxy_read_timeout 300s;
    }
}