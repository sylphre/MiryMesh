#
# /etc/mirymesh/controller.env  (root:root, 0600)
# controller-secrets.conf.example の drop-in から読み込む。行頭の # を外して値を入れる。
# 値の中身は config.yaml の auth.master_key / db.dsn と同じ。

# AES-GCM の鍵。必須。ローテーション手順は README の「設定」を参照。
# MIRYMESH_MASTER_KEY=

# ローテーション中だけ、旧鍵をカンマ区切りで指定する。
# MIRYMESH_MASTER_KEY_OLD=

# setup 前に DB 接続先を上書きする。
# MIRYMESH_DB_DSN=