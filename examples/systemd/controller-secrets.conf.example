#
# Master 鍵や DB の接続文字列を config.yaml ではなく環境変数ファイルで渡す drop-in。
# 環境変数ファイルの中身は controller.env.example を参照。
#
# 配置: /etc/systemd/system/mirymesh-controller.service.d/10-secrets.conf
#   sudo mkdir -p /etc/systemd/system/mirymesh-controller.service.d
#   sudo cp controller-secrets.conf.example /etc/systemd/system/mirymesh-controller.service.d/10-secrets.conf
#   sudo install -m 0600 -o root -g root controller.env.example /etc/mirymesh/controller.env
#   (controller.env を編集して値を入れる)
#   sudo systemctl daemon-reload && sudo systemctl restart mirymesh-controller
#
# EnvironmentFile は systemd (root) が読むので、ファイルは root:root 0600 でよい。

[Service]
EnvironmentFile=/etc/mirymesh/controller.env