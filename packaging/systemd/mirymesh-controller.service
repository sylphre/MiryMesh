[Unit]
Description=MiryMesh Controller (S3 on 0.0.0.0:9000 / Admin on 0.0.0.0:9001 — Tailscale 100.114.64.41:900x or reverse-proxy; do not expose 0.0.0.0:900x to public)
After=network.target

[Service]
Type=simple
User=mirymesh
Group=mirymesh
ExecStart=/usr/bin/mirymesh-controller /etc/mirymesh/config.yaml
Restart=on-failure
RestartSec=2
Environment=GODEBUG=
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mirymesh /var/log/mirymesh /etc/mirymesh

[Install]
WantedBy=multi-user.target
