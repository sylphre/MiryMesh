[Unit]
Description=MiryMesh Controller (S3 API on :9000, admin on :9001 — Tailscale/localhost only)
After=network.target

[Service]
Type=simple
User=mirymesh
Group=mirymesh
ExecStart=/usr/bin/mirymesh-controller /etc/mirymesh/config.yaml
Restart=on-failure
RestartSec=2
Environment=GODEBUG=
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mirymesh /var/log/mirymesh

[Install]
WantedBy=multi-user.target
