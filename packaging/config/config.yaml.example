# MiryMesh config example — /etc/mirymesh/config.yaml
server:
  listen: "0.0.0.0:9000" # S3: Tailscale <tailscale-ip>:9000 or reverse-proxy (port 80) -> 127.0.0.1:9000. Do NOT expose 0.0.0.0:9000 to public; use firewall/Tailscale ACL
  admin_listen: "0.0.0.0:9001" # Admin: Tailscale <tailscale-ip>:9001 or localhost. Do NOT expose 0.0.0.0:9001 to public; keep behind firewall/Tailscale ACL or bind 127.0.0.1:9001
  mode: gateway # Master holds no S3 objects; all data lives on DataNodes. "" or "standalone" = master also stores (single-node)
  region: "us-east-1"
  data_dir: "/var/lib/mirymesh"
auth:
  # master_key: "<64 hex chars, 32-byte base64, or >=32 chars>" # or MIRYMESH_MASTER_KEY env. Encrypts secret_key_enc / dsn_enc.
  # old_master_keys: [] # Only while rotating: list the previous key(s), run "mirymesh rotate-master-key", then remove them. Env: MIRYMESH_MASTER_KEY_OLD (comma-separated).
  credentials:
    - access_key: "TESTKEY"
      secret_key: "testsecret12345"
storage:
  default_policy: "single"
datanode:
  listen: "0.0.0.0:9002" # DataNode: Tailscale <tailscale-ip>:9002 or localhost. Do NOT expose to public; firewall/Tailscale ACL
  controller_url: "http://127.0.0.1:9000"
  paths: ["/mnt/mirymesh/disk1"]
log:
  level: "info"
