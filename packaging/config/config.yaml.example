# MiryMesh config example — /etc/mirymesh/config.yaml
server:
  listen: ":9000"
  admin_listen: ":9001" # Admin GUI/API: keep on Tailscale or localhost, do NOT expose to 0.0.0.0 if possible
  mode: gateway # Master holds no S3 objects; all data lives on DataNodes. "" or "standalone" = master also stores (single-node)
  region: "us-east-1"
  data_dir: "/var/lib/mirymesh"
auth:
  credentials:
    - access_key: "TESTKEY"
      secret_key: "testsecret12345"
storage:
  default_policy: "single"
datanode:
  controller_url: "http://127.0.0.1:9000"
  paths: ["/mnt/mirymesh/disk1"]
log:
  level: "info"
